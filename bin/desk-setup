#!/usr/bin/env bash
# One time: store the Linux password for the RDP login in the macOS Keychain.
#
# The value goes straight into the Keychain through security's own prompt, so it
# never lands in a shell variable, a file, or a process argument list. At connect
# time `desk` reads it and hands it to FreeRDP on stdin, so it never appears in
# `ps` either.
set -uo pipefail

ROOT="$(cd -P "$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"

desk_load_config "$ROOT"

security delete-generic-password -s "$DESK_KEYCHAIN_SERVICE" -a "$DESK_USER" >/dev/null 2>&1 \
  && desk_say "removed the previous entry"

cat <<INFO

This is the LINUX password for '$DESK_USER' on $DESK_HOST, the one 'sudo' asks
for there. It is NOT a new password. Nothing is echoed as you type, and you
will be asked for it twice.

INFO

security add-generic-password -s "$DESK_KEYCHAIN_SERVICE" -a "$DESK_USER" -w < /dev/tty > /dev/tty

# Check the length only. Printing the value would defeat the point of the
# prompt, and a zero-length entry is the failure worth catching: security
# accepts an empty password without complaint.
v="$(security find-generic-password -s "$DESK_KEYCHAIN_SERVICE" -a "$DESK_USER" -w 2>/dev/null || true)"
n=${#v}
unset v

echo
if [ "$n" -ge 4 ]; then
  desk_say "Stored, and the length looks sane ($n characters). Run: desk"
else
  desk_die "The stored value is only $n characters, which looks wrong. Run this again."
fi
