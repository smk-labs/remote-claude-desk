#!/usr/bin/env bash
# Forward the RDP port for a native client such as Microsoft's Windows App, and
# push the keyboard layout into the session, because nothing else will.
#
# The layout is not a nicety. xrdp sets the session keymap from what the client
# announces, after xfce4-settings has had its say, so every session comes up as
# plain "us" no matter what is configured on the server. `desk` pushes the real
# layout on every connect; this used to say a native client was "on its own" and
# leave it, which in practice meant the Persian keyboard did not exist and the
# Fn key did nothing. Measured on a live session reached this way:
# `setxkbmap -query` said layout: us, and keycodes 191 to 202 were all empty.
#
# desk-tunnel does its work and exits, which is right: it holds nothing open,
# the SSH master does. But that means something has to run it, and "run it
# yourself, every time, before you can work" is not a design, it is a chore.
#
# So a LaunchAgent per machine, running `--watch`: do the work, then stay and
# check every fifteen seconds that the tunnel still carries RDP, and exit the
# moment it does not so launchd starts a fresh one.
#
# It used to be a five-minute StartInterval instead, and that is what made the
# thing feel unreliable. A wifi handoff, a sleep, a VPN switch, and the port is
# gone for up to five minutes. The client says the PC is offline, which is true
# and useless: the box is fine, the tunnel is not. Watching closes that window
# to seconds, and it is also the only way to notice a tunnel that is listening
# and dead, which no interval can catch by definition.
#
# One agent per machine, labelled by host, because two boxes are normal here and
# a single agent could only ever serve one of them.
set -uo pipefail

ROOT="$(cd -P "$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"

desk_load_config "$ROOT"

# The folder the RDP client redirects. bin/desk used to create it and nothing
# did after that was deleted, so desk-doctor's "desk-tunnel creates it" was a
# promise no code kept.
mkdir -p "$DESK_SHARE"

AGENT_DIR="$HOME/Library/LaunchAgents"
AGENT_LABEL="com.smk-labs.desk-tunnel.$DESK_HOST"
AGENT_PLIST="$AGENT_DIR/$AGENT_LABEL.plist"

# --watch does the same work first, then keeps watching. Anything below that
# fails is a failure of the tunnel itself, so it is worth exiting on either way.
WATCH=0
[ "${1:-}" = "--watch" ] && { WATCH=1; shift; }

FAIL_FILE="$HOME/.cache/remote-claude-desk/$DESK_HOST.fails"
mkdir -p "$HOME/.cache/remote-claude-desk" 2>/dev/null || true

# Slow down when the far side is simply not there.
#
# launchd restarts a KeepAlive job as fast as ThrottleInterval allows, and every
# restart on ousmousa spends a TOTP code at the login prompt. A box that is off
# for an hour would burn 120 of them. So a failed watch run sleeps before it
# exits, longer each consecutive time, and launchd's clock only starts after
# that. Ten minutes is the ceiling: long enough to be quiet, short enough that a
# box coming back is picked up while you are still making coffee.
_backoff_then_exit() {
  local rc=$? n wait
  { [ "$WATCH" = 1 ] && [ "$rc" -ne 0 ]; } || exit "$rc"
  n=$(( $(cat "$FAIL_FILE" 2>/dev/null || echo 0) + 1 ))
  printf '%s' "$n" > "$FAIL_FILE"
  wait=$(( 30 * (1 << (n > 5 ? 5 : n - 1)) ))
  [ "$wait" -gt 600 ] && wait=600

  # The hold is for a box that is OFF. It stopped being right the moment the
  # box came back, and it used to keep sleeping anyway: an outage drove the
  # counter to five, the network returned two minutes later, and the tunnel
  # stayed down for the remaining eight minutes of a penalty aimed at a
  # condition that had already ended. That is the window the user hits, and it
  # is self-inflicted.
  #
  # So ask. If the far host answers SSH, the reason for the long hold is gone:
  # wait a few seconds and let launchd try, which costs at most one TOTP code
  # against a host that is demonstrably there.
  if [ "$wait" -gt 30 ] && desk_host_reachable; then
    desk_log "watch: run failed (rc=$rc, consecutive=$n), but $DESK_HOST answers SSH. Holding 15s instead of ${wait}s."
    wait=15
  else
    desk_log "watch: run failed (rc=$rc, consecutive=$n). Holding ${wait}s before launchd retries."
  fi
  sleep "$wait"
  exit "$rc"
}
trap _backoff_then_exit EXIT

case "${1:-}" in
  --install)
    mkdir -p "$AGENT_DIR" "$HOME/.cache/remote-claude-desk"
    # PATH is spelled out because launchd hands an agent almost none. ssh needs
    # /usr/bin, and ousmousa's 2FA hook needs expect and oathtool, which live in
    # Homebrew. An agent that cannot find oathtool fails at the login prompt and
    # says nothing anyone would connect to a missing PATH.
    cat > "$AGENT_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AGENT_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$ROOT/bin/desk-tunnel</string>
    <string>--watch</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DESK_CONFIG</key><string>$DESK_CONFIG_FILE</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>$HOME/.cache/remote-claude-desk/tunnel-agent.log</string>
  <key>StandardErrorPath</key><string>$HOME/.cache/remote-claude-desk/tunnel-agent.log</string>
</dict>
</plist>
PLIST
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
    if launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null; then
      desk_say "installed $AGENT_LABEL"
      desk_say "  it runs now, at every login, and is restarted whenever it exits."
      desk_say "  log: $HOME/.cache/remote-claude-desk/tunnel-agent.log"
      desk_say "  remove it with: desk-tunnel --uninstall"
      exit 0
    fi
    desk_die "could not load $AGENT_PLIST"
    ;;
  --uninstall)
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
    rm -f "$AGENT_PLIST"
    desk_say "removed $AGENT_LABEL"
    exit 0
    ;;
  --help|-h)
    cat <<USAGE
desk-tunnel              forward the port and push the keyboard layout, once
desk-tunnel --watch      do that, then hold the tunnel up until it cannot be
desk-tunnel --install    run --watch at login and keep it running, for this machine
desk-tunnel --uninstall  stop doing that

Which machine is decided by DESK_CONFIG, the same way desk-doctor decides.
USAGE
    exit 0
    ;;
esac

desk_ensure_master

# Heal an orphaned session before forwarding, not after.
#
# A session that outlived its sesman is untracked forever, and every later
# connect makes a new one that dies at once with ERRINFO_LOGOFF_BY_USER, which
# reads like a network fault and is not one. The why is in
# remote/heal-orphans.sh, beside the code that does it.
#
# This used to be `desk`'s preflight and was its only caller. desk-tunnel is the
# right home for it now: it runs before every connection and, once the
# LaunchAgent is installed, again every five minutes, so an orphan created while
# the laptop was shut is cleared before anyone notices it.
#
# Best effort: a server that cannot be healed is still worth trying to reach.
desk_remote_run heal-orphans.sh >/dev/null 2>&1 || true

desk_forward

# The layout needs a session to push into, and with a native client the session
# may not exist until after it connects. So this is a report, never a failure:
# no session yet is the normal state on a first run, and running desk-tunnel
# again once connected is what fixes it. Saying which of the two happened is the
# whole point, because a silent no-op here looks exactly like a working setup
# until the moment you type Persian.
layout_note="run desk-tunnel again once connected, to load '$DESK_LAYOUTS'"
if display="$(desk_remote_display 2>/dev/null)" && [ -n "$display" ]; then
  # Same ceiling as desk: 12 tries, 2 seconds apart, three passes in a row
  # before it is believed, because xrdp can overwrite the keymap after the first
  # one lands.
  if desk_retry 12 2 3 -- desk_remote_run apply-layout.sh \
       "DISP=$display" "LAYOUTS=$DESK_LAYOUTS" "TOGGLE=$DESK_LAYOUT_TOGGLE"; then
    layout_note="keyboard '$DESK_LAYOUTS' loaded on $display (Option+Shift switches)"
  else
    layout_note="could not confirm '$DESK_LAYOUTS' on $display after 12 tries"
  fi
fi

# ─── the clipboard, Mac to remote ───────────────────────────────────────────
#
# This direction does NOT go over RDP, and that is the whole point.
#
# Windows App deadlocks when an image lands on the Mac pasteboard while it is
# redirecting the clipboard towards the remote side. A screenshot is enough. The
# app then stops carrying the clipboard at all, refuses to reopen the session it
# just closed, and only a full quit clears it. It is a known bug in the client:
# reported to Microsoft repeatedly since early 2026, unacknowledged, unfixed as
# of 11.4.0, and absent from other RDP clients. The reporter's reading is a race
# that leaves a mutex around the system pasteboard held.
#
# So the client redirects no clipboard at all, mode 0. Mode 3, remote to local
# only, is the workaround the public reports settle on, and it does avoid the
# deadlock. Mode 0 is better here for a reason those reports do not have: this
# bridge carries both directions, so turning the channel off entirely costs
# nothing and leaves no second owner of the X CLIPBOARD selection to race with.
#
# desk-clip cannot deadlock the client because it never speaks to it. It reads
# the Mac pasteboard directly and writes the X selection over the SSH master
# that is already up for the tunnel. It was written for a different reason (the
# RDP channel dropped every non-ASCII byte, so Persian arrived empty) and it
# turns out to be the answer to this one too.
#
# Started detached, because desk-tunnel exits and the bridge must not. Started
# only if this machine has none, so the five-minute re-run heals a dead bridge
# and does nothing to a live one.
bridge_note="not started: no session to attach one to"
if [ -n "${display:-}" ]; then
  if pgrep -f "[d]esk-clip --for .*:${DESK_LOCAL_PORT}\$" >/dev/null 2>&1; then
    bridge_note="already running"
  elif [ -x "$ROOT/bin/desk-clip" ]; then
    # nohup, not setsid: macOS ships no setsid, and the first version of this
    # line failed with "command not found" into a log nobody was watching.
    DESK_DISPLAY="$display" nohup "$ROOT/bin/desk-clip" \
      --for "$DESK_HOST:$DESK_LOCAL_PORT" </dev/null \
      >>"$HOME/.cache/remote-claude-desk/clip.log" 2>&1 &
    disown 2>/dev/null || true
    bridge_note="started on $display (text and images, both ways, over SSH)"
  else
    bridge_note="desk-clip is not at $ROOT/bin/desk-clip"
  fi
fi

cat <<INFO
Tunnel up on 127.0.0.1:${DESK_LOCAL_PORT}
Keyboard: ${layout_note}
Clipboard: ${bridge_note}

In your RDP client, add a PC:
  PC name    localhost:${DESK_LOCAL_PORT}
  User       ${DESK_USER}
  Folders    add ${DESK_SHARE} to get the shared drive

The tunnel stays up as long as the SSH master lives.
INFO

# The tunnel is up.
#
# Reset the backoff, and disarm it. It exists to slow down repeated failures to
# ESTABLISH, when the box is off and every attempt spends a TOTP code. A tunnel
# that came up and later dropped is the opposite case: a wifi handoff deserves
# an immediate rebuild, not thirty seconds of penance for something that was
# working a moment ago.
printf '0' > "$FAIL_FILE" 2>/dev/null || true

# The backoff trap is replaced, not simply removed. Removing it left every exit
# after this point silent, and a silent exit is a restart nobody can explain:
# two watchers went down together one night with 161 launchd runs behind them
# and not one line saying what ended them. A supervisor that restarts things
# quietly turns a bug into weather.
#
# So from here on, every way out says so, signals included. It costs one line in
# the log per run and it is the difference between reading a cause and guessing
# at one.
_log_exit() {
  local rc=$?
  desk_log "watch: run for $DESK_HOST ended (rc=$rc)"
  exit "$rc"
}
_log_signal() {
  desk_log "watch: run for $DESK_HOST was sent $1, stopping."
  exit 0
}
trap _log_exit EXIT
trap '_log_signal SIGTERM' TERM
trap '_log_signal SIGHUP' HUP
trap '_log_signal SIGINT' INT

[ "$WATCH" = 1 ] || exit 0

# ─── watching ───────────────────────────────────────────────────────────────
#
# Everything above happens once and is idempotent. This is the part that makes
# the tunnel feel like it is simply always there.
#
# The check is desk_forward_healthy: our master owns the local port, and an RDP
# server answers a real handshake through it. It costs about half a second and
# it is the same question the client is about to ask, which is why it catches
# the case an interval never can: a listener that accepts and then says nothing.
#
# On failure it exits rather than repairing in place. launchd is already a
# supervisor and a better one than a loop here would be: a fresh run redoes the
# master, the forward, the keyboard and the bridge in the right order, with the
# same code path a manual run uses. Two ways to repair one thing is how the
# repair drifts from the setup.
WATCH_INTERVAL="${DESK_WATCH_INTERVAL:-15}"
# A ceiling on the watcher itself. Nothing here is meant to run for weeks, and a
# process that has been alive since a laptop was last rebooted is a process
# nobody has proved still works. Six hours, then hand back to launchd.
WATCH_MAX_LIFE="${DESK_WATCH_MAX_LIFE:-21600}"
# How many probes must fail before the tunnel is declared dead, and how long to
# wait between them. Three tries two seconds apart: a burst of jitter is ridden
# out, a genuinely dead forward is still called within six seconds.
PROBE_TRIES="${DESK_PROBE_TRIES:-3}"
PROBE_GAP="${DESK_PROBE_GAP:-2}"
# The clipboard bridge is checked every fourth tick, so a minute at the default
# interval rather than the five minutes this used to be. A pgrep costs nothing
# and five minutes of a silently dead clipboard is five minutes of copying into
# a void, which is exactly how the last outage was noticed: by hand, by a
# person, long after the machinery could have said so.
BRIDGE_EVERY="${DESK_BRIDGE_EVERY:-4}"

desk_log "watch: up on 127.0.0.1:$DESK_LOCAL_PORT, checking every ${WATCH_INTERVAL}s"
started="$(date +%s)"
tick=0

while :; do
  sleep "$WATCH_INTERVAL"
  tick=$((tick + 1))

  # One failed probe is not a dead tunnel, and treating it as one is what made
  # this setup feel unreliable. The probe shares the SSH master with the
  # desktop's own pixels, so a frame burst or a moment of jitter can eat it
  # while the session it is testing is perfectly fine. Every teardown here kills
  # a live RDP session and, on ousmousa, spends a TOTP code on the rebuild.
  #
  # So a failure has to be confirmed: PROBE_TRIES attempts, PROBE_GAP apart,
  # and only all of them failing is a tunnel worth rebuilding. The cost of
  # being wrong is asymmetric, which is the whole argument. A missed real
  # failure costs about six extra seconds before the rebuild starts. A false
  # alarm costs the session you were working in.
  #
  # A miss that recovers is logged rather than swallowed, because a link that
  # is quietly flapping is worth seeing before it becomes an outage.
  # A recovered probe falls THROUGH to the rest of the body rather than jumping
  # back to the top. The first version said `continue 2`, and that quietly
  # skipped both checks below it: a link that missed one probe a minute would
  # never reach the six-hour ceiling and never notice a dead clipboard bridge,
  # for as long as it kept flapping. A ceiling something can step around is not
  # a ceiling.
  if ! desk_forward_healthy; then
    recovered=0
    tries=1
    while [ "$tries" -lt "$PROBE_TRIES" ]; do
      sleep "$PROBE_GAP"
      tries=$((tries + 1))
      if desk_forward_healthy; then
        desk_log "watch: 127.0.0.1:$DESK_LOCAL_PORT missed a probe, answered on try $tries. Not rebuilding."
        recovered=1
        break
      fi
    done
    if [ "$recovered" = 0 ]; then
      desk_log "watch: 127.0.0.1:$DESK_LOCAL_PORT failed $PROBE_TRIES probes in a row. Exiting so launchd rebuilds it."
      exit 1
    fi
  fi

  # The bridge dies on its own terms: desk-clip stops after enough consecutive
  # failures, which a long outage produces, and then the clipboard is quietly
  # gone while everything else looks perfect. Cheap to notice, so notice it.
  if [ $((tick % BRIDGE_EVERY)) -eq 0 ] && [ -n "${display:-}" ]; then
    if ! pgrep -f "[d]esk-clip --for .*:${DESK_LOCAL_PORT}\$" >/dev/null 2>&1; then
      desk_log "watch: the clipboard bridge is gone. Exiting for a fresh run that restarts it."
      exit 0
    fi
  fi

  if [ $(( $(date +%s) - started )) -ge "$WATCH_MAX_LIFE" ]; then
    desk_log "watch: ${WATCH_MAX_LIFE}s up, exiting for a fresh run."
    exit 0
  fi
done
