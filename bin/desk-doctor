#!/usr/bin/env bash
# Check every precondition and say which one is wrong.
#
# This exists because almost every failure in this setup looks like the same
# thing from the outside: a window that does not open, or one that opens and
# quits. The cause is somewhere in a chain of about twenty links, and guessing
# which one costs an evening. Each check below is a link in that chain, and
# most of them are a bug that actually happened.
#
#   desk-doctor            check everything
#   desk-doctor --local    skip the checks that need the server
#
# Exits non-zero if anything is broken, so it also works in a script.
set -uo pipefail

ROOT="$(cd -P "$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"

PASS=0 WARN=0 FAIL=0
ok()   { printf '  ok    %s\n' "$*"; PASS=$((PASS + 1)); }
warn() { printf '  warn  %s\n' "$*"; WARN=$((WARN + 1)); }
bad()  { printf '  FAIL  %s\n' "$*"; FAIL=$((FAIL + 1)); }
fix()  { printf '        -> %s\n' "$*"; }
head_() { printf '\n%s\n' "$*"; }

LOCAL_ONLY=0
[ "${1:-}" = "--local" ] && LOCAL_ONLY=1
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

# ─── config ──────────────────────────────────────────────────────────────────
head_ "Config"
# Which file wins is desk_load_config's decision, and this asks it rather than
# working it out again. It used to keep a second copy of the candidate list,
# which was fine while there were exactly two candidates and wrong the moment
# DESK_CONFIG named a third: the doctor loaded one machine's config and printed
# the other machine's path, which is the one line in this whole command a person
# reads to check they are pointed at the right box.
#
# The missing-config case is gone from here too, rather than duplicated:
# desk_load_config exits with the same two lines of instruction.
desk_load_config "$ROOT"
ok "config at $DESK_CONFIG_FILE"
ok "host '$DESK_HOST', user '$DESK_USER', listener $DESK_RDP_ADDR:$DESK_RDP_PORT"

# ─── the Mac side ────────────────────────────────────────────────────────────
head_ "This Mac"


# What macOS already wrote down about the client, which nothing here used to read.
#
# When an app stops servicing its main thread, macOS samples it and files a
# report under /Library/Logs/DiagnosticReports with every thread's stack in it.
# That is the difference between "the desktop froze again, maybe the network"
# and one line naming the function it stopped in. Two of these sat on the disk
# for two days while the freeze was blamed on the clipboard, the scroll and the
# server in turn.
# Windows App only. This read both clients while both existed, and the day
# FreeRDP was deleted that became a bug: the newest report on this disk was a
# FreeRDP hang from the day before, so the doctor warned on every run about a
# freeze in a client that is no longer installed, and a real Windows App hang
# filed after it would have been hidden behind that one.
newest_hang="$(ls -t "/Library/Logs/DiagnosticReports/Windows App"*.hang 2>/dev/null | head -1)"
if [ -n "$newest_hang" ]; then
  hang_age=$(( ( $(date +%s) - $(stat -f %m "$newest_hang" 2>/dev/null || echo 0) ) / 86400 ))
  # The deepest frame that still names a subsystem. The rows under it are the
  # kernel and the C library's own primitives, and "semaphore_timedwait_trap" is
  # true of every wait there has ever been, so it tells nobody anything. The
  # frame above it does: -[CAMetalLayer nextDrawable] is a whole diagnosis.
  hang_where="$(awk '
      /^Heaviest stack for the main thread/ {f=1; next}
      f && /^$/ {exit}
      f && /^ *\*/ {next}
      f && /libsystem_kernel|libdispatch|libsystem_platform|libsystem_pthread/ {next}
      f {last=$0}
      END {print last}' "$newest_hang" 2>/dev/null \
                  | sed -E 's/^ *[0-9]+ +//; s/ \+ [0-9]+ .*//' | cut -c1-70)"
  hang_secs="$(awk '/^Duration:/ {sub(/\..*/, "", $2); print $2; exit}' "$newest_hang" 2>/dev/null)"
  if [ "$hang_age" -le 7 ]; then
    warn "the client hung for ${hang_secs:-?}s on $(date -r "$newest_hang" '+%b %d'), and macOS recorded where"
    fix "it stopped in: ${hang_where:-unknown}"
    fix "full report: $newest_hang"
  else
    ok "no client hang recorded in the last 7 days (the last was ${hang_age} days ago)"
  fi
else
  ok "macOS has never recorded the client hanging"
fi


# Nothing on the Mac runs Python any more. It is the SERVER that needs it, for
# remote/scroll-probe.py, and remote/check.sh asks about it there.

case ":$PATH:" in
  *":$HOME/bin:"*) ok "~/bin is on PATH" ;;
  *) warn "~/bin is not on PATH, so 'desk-tunnel' will not resolve"
     fix "add to your shell profile:  export PATH=\"\$HOME/bin:\$PATH\"" ;;
esac

for name in $DESK_COMMANDS; do
  link="$HOME/bin/$name"
  if [ ! -e "$link" ]; then
    warn "~/bin/$name is missing"
    fix "run $ROOT/mac/install.sh"
  elif [ "$(desk_resolve "$link")" = "$ROOT/bin/$name" ]; then
    ok "~/bin/$name points into this repo"
  else
    warn "~/bin/$name points at $(desk_resolve "$link"), not this repo"
  fi
done

# The whole reason the symlink is resolved before dirname. A stale link that
# ─── the three things the clipboard fix depends on ───────────────────────────
#
# Windows App deadlocks when an image reaches the Mac pasteboard while it is
# redirecting the clipboard. A screenshot taken over a full-screen session hits
# it every time: the clipboard stops, the window will not reconnect, and only
# quitting the whole app clears it. The bug is inside a closed client, so the
# fix is to take that path out of use entirely and carry the clipboard over SSH
# instead, which loses nothing: text and images still cross both ways.
#
# That leaves three conditions, and every one of them fails silently. This is
# the check that turns "it works today" into something that stays true, because
# on 2026-09-05 the bridge died during an unrelated outage and the only symptom
# was copy and paste quietly not working.
head_ "Clipboard"

# 1. The Mac must not redirect the clipboard.
redir="$(defaults read com.microsoft.rdc.macos ClientSettings.DisableClipboardRedirection 2>/dev/null)"
if [ "$redir" = "1" ]; then
  ok "Windows App is not redirecting the clipboard, so the deadlock cannot happen"
else
  bad "Windows App IS redirecting the clipboard, so a screenshot will wedge the session"
  fix "defaults write com.microsoft.rdc.macos ClientSettings.DisableClipboardRedirection -bool true"
  fix "then quit Windows App completely and reopen it"
fi

# 2. The bridge must be running, or nothing carries the clipboard at all.
if pgrep -f "[d]esk-clip --for .*:${DESK_LOCAL_PORT}\$" >/dev/null 2>&1; then
  ok "the SSH clipboard bridge is running for this machine"
else
  bad "no clipboard bridge for this machine, so nothing carries copy and paste"
  fix "desk-tunnel starts it; the LaunchAgent re-runs that every 5 minutes"
fi

# 3. Both owners of the X CLIPBOARD selection cannot coexist. The server half of
# this is asked in remote/check.sh, which can see xrdp.ini.

# The clipboard image shim lives on the server, not here, so what this can check
# is that the repo still ships it. remote/check.sh asks the server whether it is
# actually running.
# Dormant while the RDP clipboard is off, because the bridge delivers png
# directly and there is no BMP to convert. It matters again the moment anyone
# turns the channel back on, so its absence is worth a word, not an alarm.
[ -x "$ROOT/remote/clip-png.sh" ] \
  && ok "the clipboard image shim is in remote/ (dormant while RDP's channel is off)" \
  || warn "remote/clip-png.sh is missing, so images would not paste if RDP's clipboard were on"

[ -d "$DESK_SHARE" ] \
  && ok "shared folder $DESK_SHARE" \
  || warn "shared folder $DESK_SHARE does not exist yet (desk-tunnel creates it)"


if [ -d "$HOME/.config/karabiner" ]; then
  # WindowsApp, not sdl-freerdp. The rules reached FreeRDP through a file_paths
  # key that sat beside the bundle identifiers, so grepping for the old name
  # would keep reporting green off a line that no longer decides anything.
  if grep -rqs 'WindowsApp' "$HOME/.config/karabiner/karabiner.json" 2>/dev/null; then
    ok "Karabiner rules are enabled for the RDP client"
  else
    warn "Karabiner is installed but no rule targets the RDP client"
    fix "run mac/install.sh, then enable the rules in Karabiner's UI"
  fi
else
  warn "Karabiner-Elements is not installed (Cmd+arrow, Cmd+Q and Fn stay unmapped)"
fi

# ─── ssh ─────────────────────────────────────────────────────────────────────
head_ "SSH"

if ssh -G "$DESK_HOST" >/dev/null 2>&1; then
  cpath="$(ssh -G "$DESK_HOST" 2>/dev/null | awk '/^controlpath /{print $2}')"
  cpath="${cpath/#\~/$HOME}"
  ok "host '$DESK_HOST' resolves in the ssh config"
  if [ -z "$cpath" ] || [ "$cpath" = "none" ]; then
    bad "that host has no ControlPath, so the multiplexed master cannot be shared"
    fix "add to ~/.ssh/config:  ControlMaster auto / ControlPath $DESK_SSH_SOCKET / ControlPersist yes"
  elif [ "$cpath" != "$DESK_SSH_SOCKET" ]; then
    bad "ControlPath is '$cpath' but DESK_SSH_SOCKET is '$DESK_SSH_SOCKET'"
    fix "make the two match, or every command opens its own connection"
  else
    ok "ControlPath matches DESK_SSH_SOCKET"
  fi
else
  bad "'$DESK_HOST' is not a host in your ssh config"
fi

if [ "$LOCAL_ONLY" = "1" ]; then
  head_ "Server"
  echo "  skipped (--local)"
else
  if desk_master_up; then
    ok "SSH master is up"
  else
    warn "SSH master is down (desk-tunnel brings it up on its own)"
    [ -n "$DESK_CONNECT_CMD" ] && fix "it will run DESK_CONNECT_CMD" \
                               || fix "it will run a plain ssh -fNM"
  fi
fi

# ─── the tunnel ──────────────────────────────────────────────────────────────
#
# This section exists because of one evening. Every check above passed, the
# server was up, the session was alive, and Windows App said the PC was offline.
# It was right: nothing was listening on the port. The agent was a five-minute
# interval, the master had dropped, and the answer to "is the tunnel up" was a
# question nobody was asking.
head_ "Tunnel"

agent_label="com.smk-labs.desk-tunnel.$DESK_HOST"
agent_plist="$HOME/Library/LaunchAgents/$agent_label.plist"
if [ ! -f "$agent_plist" ]; then
  bad "no LaunchAgent for '$DESK_HOST', so nothing holds its tunnel up"
  fix "desk-tunnel --install"
else
  if grep -q "StartInterval" "$agent_plist"; then
    # The old shape. It works, in the sense that it comes back within five
    # minutes, which is exactly as long as it takes to decide the thing is
    # broken and go and do something else.
    bad "$agent_label is the old five-minute interval agent, not a watcher"
    fix "desk-tunnel --install   (it rewrites the plist to KeepAlive + --watch)"
  elif ! grep -q -- "--watch" "$agent_plist"; then
    bad "$agent_label does not run --watch, so it exits and leaves nothing watching"
    fix "desk-tunnel --install"
  else
    ok "$agent_label is a watcher (KeepAlive, --watch)"
  fi
  agent_pid="$(launchctl print "gui/$(id -u)/$agent_label" 2>/dev/null | awk '/^\tpid = /{print $3; exit}')"
  if [ -n "$agent_pid" ]; then
    ok "it is running now (pid $agent_pid)"
  else
    warn "it is installed but not running at this moment"
    fix "launchctl kickstart -k gui/$(id -u)/$agent_label"
    fix "log: $HOME/.cache/remote-claude-desk/tunnel-agent.log"
  fi
fi

if [ "$LOCAL_ONLY" = "1" ]; then
  echo "  skipped the live checks (--local)"
else
  # Who owns the port, asked exactly. Two machines on one Mac means two ports,
  # and the failure that produces is not a failure at all from the outside: the
  # client connects, logs in, and you are on the other box wondering why your
  # windows moved.
  owner_pid="$(desk_port_owner_pid "$DESK_LOCAL_PORT")"
  master_pid="$(desk_master_pid)"
  if [ -z "$owner_pid" ]; then
    bad "nothing is listening on 127.0.0.1:$DESK_LOCAL_PORT, so the client will say the PC is offline"
    fix "desk-tunnel"
  elif [ -n "$master_pid" ] && [ "$owner_pid" != "$master_pid" ]; then
    bad "127.0.0.1:$DESK_LOCAL_PORT is held by pid $owner_pid, not this machine's master (pid $master_pid)"
    fix "that is the other machine's tunnel or a leftover: lsof -nP -iTCP:$DESK_LOCAL_PORT -sTCP:LISTEN"
  else
    ok "127.0.0.1:$DESK_LOCAL_PORT is this machine's own forward (pid $owner_pid)"
  fi

  # The handshake. Everything else can pass while this fails, which is the whole
  # reason it is here: a master that survived a network drop keeps its listener
  # and carries nothing.
  if [ -n "$owner_pid" ]; then
    if desk_rdp_probe "$DESK_LOCAL_PORT"; then
      ok "an RDP server answers a real handshake through it"
    else
      bad "the port accepts a connection but no RDP server answers through it"
      fix "the master is up but its channels are dead. desk-tunnel rebuilds it."
    fi
  fi
fi

# ─── the server ──────────────────────────────────────────────────────────────
if [ "$LOCAL_ONLY" != "1" ]; then
head_ "Server"

if ! desk_master_up && ! ssh -o ConnectTimeout=10 -o BatchMode=yes "$DESK_HOST" true 2>/dev/null; then
  bad "cannot reach $DESK_HOST over ssh, so the server cannot be checked"
  # Not just "bring it up": desk_reach_report separates a box that is off from a
  # VPN swallowing the route from a login that is being refused. Those three
  # have nothing in common as fixes.
  desk_reach_report
  fix "fix the cause named above, then run desk-doctor again"
else
  # One round trip for everything, in remote/check.sh. Each line it prints is
  # "STATUS<tab>TEXT", and the loop below turns those back into the same four
  # verbs used locally, so a check reads identically whichever side it ran on.
  # SIZE goes over too, because the framebuffer is priced on the server: xrdp
  # encodes every frame in software, so the cost of DESK_SIZE is paid by a CPU
  # that only the far side can count.
  REMOTE="$(desk_remote_run check.sh \
              "MIN=$DESK_DISPLAY_MIN" "ADDR=$DESK_RDP_ADDR" "PORT=$DESK_RDP_PORT" \
              "SIZE=${DESK_SIZE:-1920x1080}" 2>/dev/null)"

  if [ -z "$REMOTE" ]; then
    bad "the server checks returned nothing"
  else
    while IFS="$(printf '\t')" read -r status message; do
      [ -n "$message" ] || continue
      case "$status" in
        ok)   ok   "$message" ;;
        warn) warn "$message" ;;
        fix)  fix  "$message" ;;
        note) printf '  note  %s\n' "$message" ;;
        *)    bad  "$message" ;;
      esac
    done <<< "$REMOTE"
  fi
fi
fi

# ─── verdict ─────────────────────────────────────────────────────────────────
echo
printf '%d ok, %d warnings, %d failures\n' "$PASS" "$WARN" "$FAIL"
if [ "$FAIL" -gt 0 ]; then
  echo "Fix the failures above, then run desk-tunnel."
  exit 1
fi
[ "$WARN" -gt 0 ] && echo "Warnings are things that work but are worse than they could be."
echo "Ready. Run: desk-tunnel, then connect with your RDP client."
exit 0
