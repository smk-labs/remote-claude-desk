#!/usr/bin/env bash
# Open the remote Linux desktop. One command.
#
#   desk                  connect
#   desk --stop           close the session from outside (the menu bar uses this)
#   desk --help           every knob
#
# Every run appends to ~/.cache/remote-claude-desk/last.log, so a failure is
# diagnosable without reproducing it.
set -uo pipefail

# The whole body lives inside main(), and is deliberately left unindented. That
# is not a style choice. Bash reads a script incrementally by byte offset, so
# editing this file while a copy of it is running makes the running shell resume
# at the wrong offset and die with "command not found" for functions that
# plainly exist. Wrapping the body in a function forces bash to parse all of it
# before it runs a line, which makes a mid-session edit harmless.
main() {

# Resolve the symlink before taking dirname. This is not defensive coding, it is
# a bug that shipped: desk is meant to be run as ~/bin/desk, a symlink into the
# repo, and BASH_SOURCE holds the path it was INVOKED by, not the target. So a
# plain dirname gave ~/bin, the helper next to it was not found there, and the
# clipboard bridge silently never started. No error, no log line, a working
# desktop that simply never pasted.
ROOT="$(cd -P "$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
BIN="$ROOT/bin"
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/freerdp-args.sh
. "$ROOT/lib/freerdp-args.sh"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'HELP'
desk: open the remote Linux desktop.

  desk                    connect
  desk --stop             disconnect an existing session
  desk --help             this

Per-run knobs, all optional:

  DESK_SIZE=2560x1600     match a different monitor for a 1:1 picture
  DESK_FULL=1             start fullscreen (brings back the launch flash)
  DESK_BPP=16             cheaper on bandwidth, dithers antialiased text
  DESK_CMD=0              send Super through untouched instead of as Ctrl
  DESK_CLIP=rdp           use the RDP clipboard channel (drops non-ASCII)
  DESK_SPACES=0           no separate macOS Space, so no launch flash
  DESK_GFX=1              try the EGFX codec
  DESK_GDI=sw             software rendering
  RDP_TUNE=1              bandwidth-saving flags

Settings that belong to the machine, not the run, live in config.sh.
Run desk-doctor first if anything is not working.
HELP
  exit 0
fi

desk_load_config "$ROOT"

LOGDIR="$HOME/.cache/remote-claude-desk"
LOG="$LOGDIR/last.log"
mkdir -p "$DESK_SHARE" "$LOGDIR"

# desk --stop closes the session from outside. Matches only our own client, by
# the loopback address we tunnel over, so another FreeRDP window is left alone.
if [ "${1:-}" = "--stop" ]; then
  pkill -f "[s]dl-freerdp /v:127.0.0.1:${DESK_LOCAL_PORT}" 2>/dev/null
  desk_say "stopping."
  exit 0
fi

desk_ensure_master

# ─── preflight: heal an orphaned session before it kills the connection ──────
# A session that outlived its sesman is untracked forever, and every later
# connect then makes a new one that dies at once. The why is in
# remote/heal-orphans.sh, beside the code that does it.
#
# Best effort: a server that cannot be healed is still worth trying to reach.
desk_remote_run heal-orphans.sh >/dev/null 2>&1 || true

desk_forward

# ─── the connection flags ────────────────────────────────────────────────────
# Built by lib/freerdp-args.sh, which is pure and therefore testable. Every flag
# is there because the obvious alternative broke something; the reasoning lives
# beside each one in that file, and at length in docs/why-these-settings.md.
desk_build_args
ARGS=( "${DESK_ARGS[@]}" )

# macOS Spaces. A straight trade-off, not a bug to fix:
#   1 (default) fullscreen gets its own Space, so a three-finger swipe reaches
#               it and the green button works. Cost: FreeRDP builds a window,
#               tears it down, then builds the session window, so the Space is
#               created and destroyed once at startup and the screen flashes.
#   0           stays on the current desktop. No flash, but no Space either.
export SDL_VIDEO_MAC_FULLSCREEN_SPACES="${DESK_SPACES:-1}"

desk_say "log: $LOG"
{ echo; echo "===== $(date) ====="; echo "args: ${ARGS[*]}"; } >> "$LOG"

# ─── helpers that live exactly as long as the client ─────────────────────────
HELPERS=()

cleanup() {
  local p
  for p in "${HELPERS[@]:-}"; do kill "$p" 2>/dev/null || true; done
  HELPERS=()
  # Belt and braces, in case a helper died without cleaning up after itself.
  # desk_remote_pkill brackets the pattern so it cannot match the ssh shell
  # that is running it, which used to kill the cleanup halfway through.
  desk_remote_pkill "deskclip-agent"
  desk_remote_pkill "xclip -selection clipboard"
}
trap cleanup EXIT INT TERM

# Wait for the session's X display to exist, then set up everything that needs
# to talk to it.
#
# The display is DISCOVERED, not assumed. It used to be the constant :150, and
# that is wrong whenever a session fails to start there and xrdp hands out :151
# next: the layout is then pushed at a display that is not there and the
# clipboard bridge owns a selection nobody reads. Both fail silently.
#
# It also has to WAIT, because on a first connect the session does not exist
# yet when this runs. Bounded at 15 tries, 2 seconds apart, so 30 seconds worst
# case and never forever.
#
# It runs in the background, which means it runs in a SUBSHELL, so anything it
# adds to HELPERS is added to its own copy and the parent never sees it. That
# is why it keeps and kills its own children here rather than reporting them
# upwards: without this, desk-clip outlived desk, kept the SSH channel open and
# went on owning the remote clipboard selection after the window had closed.
session_helper() {
  local display="" kids=()
  # shellcheck disable=SC2317,SC2329  # invoked by the trap below, not by name
  _reap() { local k; for k in "${kids[@]:-}"; do kill "$k" 2>/dev/null; done; }
  trap _reap EXIT TERM INT

  # Bounded at 15 tries, 2 seconds apart, so 30 seconds worst case.
  _found() { display="$(desk_remote_display 2>/dev/null)"; [ -n "$display" ]; }
  if ! desk_retry 15 2 1 -- _found; then
    desk_warn "session: could not find an X display at or above :$DESK_DISPLAY_MIN after 30s."
    desk_warn "         The keyboard layout and the clipboard bridge are both off."
    desk_warn "         Run desk-doctor to see why."
    return 1
  fi
  desk_say "session: display $display"

  apply_layout "$display" &
  kids+=($!)

  # The -x test used to be the whole condition, so a missing desk-clip meant a
  # session with no clipboard at all and not one word about why. Say it instead.
  if [ "${DESK_CLIP:-bridge}" != "rdp" ]; then
    if [ -x "$BIN/desk-clip" ]; then
      DESK_DISPLAY="$display" "$BIN/desk-clip" &
      kids+=($!)
    else
      desk_warn "clipboard: desk-clip is not at $BIN/desk-clip, so text will NOT cross."
    fi
  fi

  # Stay alive while the children do. The trap above fires when this is killed,
  # which is what actually stops them.
  wait
}

# Push the keyboard layout into the live X session.
#
# The work itself is remote/apply-layout.sh. Three consecutive passes are
# required before it is believed, because xrdp can overwrite the keymap after
# the first one lands, so a single success is not proof.
#
# Bounded by desk_retry: 12 tries, 2 seconds apart.
apply_layout() {
  local display="$1"
  if desk_retry 12 2 3 -- desk_remote_run apply-layout.sh \
       "DISP=$display" "LAYOUTS=$DESK_LAYOUTS" "TOGGLE=$DESK_LAYOUT_TOGGLE"; then
    case "$DESK_LAYOUTS" in
      *,*) desk_say "keyboard: $DESK_LAYOUTS ready (Option+Shift switches)" ;;
      *)   desk_say "keyboard: $DESK_LAYOUTS ready" ;;
    esac
    return 0
  fi
  desk_warn "keyboard: could not confirm '$DESK_LAYOUTS' after 12 tries."
  return 1
}

# Run the client. The password is read from the Keychain and handed to FreeRDP
# on stdin, so it never appears in `ps` or in a file.
run_client() {
  local rc
  if security find-generic-password -s "$DESK_KEYCHAIN_SERVICE" -a "$DESK_USER" -w >/dev/null 2>&1; then
    security find-generic-password -s "$DESK_KEYCHAIN_SERVICE" -a "$DESK_USER" -w \
      | sdl-freerdp "${ARGS[@]}" /from-stdin:force 2>&1 | tee -a "$LOG"
    # Index 1, not 0. The pipeline is security | sdl-freerdp | tee, so index 0
    # is the Keychain lookup, which all but always succeeds. Reading index 0
    # here meant desk always exited 0 and the failure excerpt below never
    # printed, which is exactly when you most want it.
    rc="${PIPESTATUS[1]}"
  else
    desk_warn "No Keychain item for '$DESK_KEYCHAIN_SERVICE'. Run: desk-setup"
    sdl-freerdp "${ARGS[@]}" 2>&1 | tee -a "$LOG"
    rc="${PIPESTATUS[0]}"
  fi
  return "$rc"
}

session_helper &
HELPERS+=($!)

run_client
rc=$?
cleanup
echo "exit=$rc" >> "$LOG"

if [ "$rc" -ne 0 ]; then
  echo
  echo "--- last failure, from the log ---"
  grep -iE 'FATAL|ERROR' "$LOG" \
    | grep -viE 'tcsetattr|tcgetattr|backtrace|log_build_warn' \
    | tail -6 | cut -c1-190
  echo
  echo "desk-doctor checks every precondition and usually names the cause."
fi
exit "$rc"

}

main "$@"
