#!/usr/bin/env bash
# Open the remote Linux desktop. One command.
#
#   desk                  connect
#   desk --stop           close the session from outside (the menu bar uses this)
#   desk --help           every knob
#
# Every run appends to ~/.cache/remote-claude-desk/last.log, so a failure is
# diagnosable without reproducing it.
set -uo pipefail

# The whole body lives inside main(), and is deliberately left unindented. That
# is not a style choice. Bash reads a script incrementally by byte offset, so
# editing this file while a copy of it is running makes the running shell resume
# at the wrong offset and die with "command not found" for functions that
# plainly exist. Wrapping the body in a function forces bash to parse all of it
# before it runs a line, which makes a mid-session edit harmless.
main() {

# Resolve the symlink before taking dirname. This is not defensive coding, it is
# a bug that shipped: desk is meant to be run as ~/bin/desk, a symlink into the
# repo, and BASH_SOURCE holds the path it was INVOKED by, not the target. So a
# plain dirname gave ~/bin, the helper next to it was not found there, and the
# clipboard bridge silently never started. No error, no log line, a working
# desktop that simply never pasted.
ROOT="$(cd -P "$(dirname "$(/bin/realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
BIN="$ROOT/bin"
# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/freerdp-args.sh
. "$ROOT/lib/freerdp-args.sh"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'HELP'
desk: open the remote Linux desktop.

  desk                    connect
  desk --stop             disconnect an existing session
  desk --help             this

Per-run knobs, all optional:

  DESK_SIZE=2560x1600     match a different monitor for a 1:1 picture
  DESK_FULL=1             start fullscreen (brings back the launch flash)
  DESK_BPP=16             cheaper on bandwidth, dithers antialiased text
  DESK_CMD=0              send Super through untouched instead of as Ctrl
  DESK_CLIP=rdp           use the RDP clipboard channel (drops non-ASCII)
  DESK_SPACES=0           no separate macOS Space, so no launch flash
  DESK_GFX=1              try the EGFX codec
  DESK_GDI=sw             software rendering
  DESK_RENDERER=metal     draw with Metal again (it deadlocks; see the comment)
  DESK_VSYNC=1            wait for the display on every frame (this is the freeze)
  RDP_TUNE=1              bandwidth-saving flags

Settings that belong to the machine, not the run, live in config.sh.
Run desk-doctor first if anything is not working.
HELP
  exit 0
fi

desk_load_config "$ROOT"

LOGDIR="$HOME/.cache/remote-claude-desk"
LOG="$LOGDIR/last.log"
mkdir -p "$DESK_SHARE" "$LOGDIR"

# desk --stop closes the session from outside. Matches only our own client, by
# the loopback address we tunnel over, so another FreeRDP window is left alone.
if [ "${1:-}" = "--stop" ]; then
  pkill -f "[s]dl-freerdp /v:127.0.0.1:${DESK_LOCAL_PORT}" 2>/dev/null
  desk_say "stopping."
  exit 0
fi

# desk --restart is the big red button: tear everything of ours down, including
# the SSH master and the helpers, and come back up from nothing.
#
# Plain `desk` already closes a previous client and reconnects through a blip on
# its own, so this is not the normal path. It is here for the state no automatic
# rule catches, when you would otherwise be hunting processes by hand.
if [ "${1:-}" = "--restart" ]; then
  desk_say "restarting from scratch."
  pkill -f "[s]dl-freerdp /v:127.0.0.1:${DESK_LOCAL_PORT}" 2>/dev/null
  # Scoped to this machine. It used to be a bare "desk-clip", so restarting one
  # desk silently killed the other desk's clipboard bridge and left that session
  # running with text that no longer crossed and nothing to say why.
  pkill -f "[d]esk-clip --for .*:${DESK_LOCAL_PORT}\$" 2>/dev/null
  ssh -S "$DESK_SSH_SOCKET" -O exit "$DESK_HOST" 2>/dev/null
  # The remote half too, so a stale bridge is not left owning the clipboard.
  desk_remote_pkill "deskclip-agent" 2>/dev/null || true
  sleep 2
  shift
fi

# The log entry is opened BEFORE anything can fail, not after the client starts.
# It used to be written just above run_client, so every failure that happened
# earlier - a dead master, a tunnel that would not answer - left the log
# untouched and looking a day old. That is the exact moment the log matters most.
{ echo; echo "===== $(date) ====="; } >> "$LOG"
desk_log() { echo "$*" >> "$LOG"; }

desk_log "master: bringing up"

# ─── the priority this was started at, which desk cannot fix and must not hide ─
#
# A remote desktop is the most latency-sensitive thing on the machine: it repaints
# in response to the pointer, and everything it draws arrives over a wire first.
# Started from a background context, it inherits that context's scheduling class,
# and a niced client under load does not crash or log anything. It just stops
# keeping up, and macOS labels the window Not Responding, which reads exactly
# like the deadlock this file spent a day chasing.
#
# It cost a whole round of testing here: a client launched from a background
# shell ran at nice 5 for hours while its freezes were being blamed on the
# renderer, the server and the clipboard in turn.
#
# desk cannot correct it. Lowering a nice value needs root, and the fix is not to
# ask for root, it is to launch from somewhere that is not niced: the menu bar
# app, or a terminal. So say it, once, at the top, where the person who typed the
# command is still looking.
_nice="$(ps -o nice= -p $$ 2>/dev/null | tr -d ' ')"
case "$_nice" in
  ''|0|-*) ;;
  *) desk_warn "this desk is running at nice $_nice, so the client will be starved under load."
     desk_warn "  Nothing here can lower it: that needs root. Start desk from the menu bar app"
     desk_warn "  or a normal terminal instead, and it will run at nice 0."
     desk_log "nice: $_nice (raised; the client will be starved)" ;;
esac

# ─── one desk at a time, not just one client ─────────────────────────────────
#
# The guard below used to end the previous CLIENT and stop there, which left the
# `desk` that owned it alive. That desk then did exactly what it is built to do:
# it saw its client gone and the tunnel down, and reconnected. So the new desk
# killed the old desk's client, the old desk started another one, and the two
# traded the session between them for as long as the laptop was on.
#
# Measured, on the morning this was found: four `desk` processes two hours old,
# three of them orphaned to init, each running its own clipboard bridge, so the
# pasteboard was being polled forty times a second instead of ten, and every
# client either of them opened was logged off within seconds by the other. From
# the outside that is not a fight, it is "the desktop keeps crashing".
#
# A pid file rather than a process name, because every desk has the same command
# line and the machine it belongs to is only in its config. One file per local
# port is therefore one file per machine, which is what lets two boxes run side
# by side and still keeps one desk each.
LOCK="$LOGDIR/desk-${DESK_LOCAL_PORT}.pid"
_lock_holder() {
  local pid
  pid="$(cat "$LOCK" 2>/dev/null)"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ "$pid" != "$$" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf %s "$pid"
}

if holder="$(_lock_holder)"; then
  desk_say "another desk for this machine is running (pid $holder), ending it first."
  # TERM, not KILL: desk traps it and runs cleanup, which is what stops its
  # bridge and its remote agent. KILL would leave both behind.
  kill -TERM "$holder" 2>/dev/null || true
  _holder_gone() { ! kill -0 "$holder" 2>/dev/null; }

  # Twenty seconds, not ten. The old desk's trap runs cleanup, and cleanup makes
  # two ssh round trips to stop the remote clipboard agent, so a graceful exit is
  # not instant on a slow link. Ten seconds was measured going off while the
  # process was still perfectly busy shutting down, which printed a warning about
  # a fight that was not happening.
  #
  # And if it really will not go, KILL it rather than carry on beside it. Its
  # cleanup has already had its twenty seconds; carrying on is the one outcome
  # this whole block exists to prevent, because two desks is the fight.
  if ! desk_retry 20 1 1 -- _holder_gone; then
    desk_warn "the previous desk (pid $holder) ignored TERM for 20s; killing it."
    kill -KILL "$holder" 2>/dev/null || true
    desk_retry 5 1 1 -- _holder_gone \
      || desk_warn "pid $holder is still there even after KILL; expect the two to fight."
  fi
fi
echo $$ > "$LOCK"

# ─── one client at a time ────────────────────────────────────────────────────
# An xrdp session is single seat. A second client does not join it, it TAKES it,
# and the client it displaced tries to take it back: FreeRDP auto-reconnects on
# its own. The two then trade the session every few seconds and both windows
# look broken.
#
# Closing the window is not enough to end that fight, which is what made this so
# confusing to hit: the window is gone, so nothing looks like it is still
# connected, and the next `desk` dies three seconds after it connects with
# ERRCONNECT_CONNECT_CANCELLED, which reads like a network fault and is not one.
#
# So: end our own previous client first, and wait for it to actually go. Same
# pattern as --stop, matched on the loopback address we tunnel over so another
# FreeRDP window on some other host is left alone.
if pgrep -f "[s]dl-freerdp /v:127.0.0.1:${DESK_LOCAL_PORT}" >/dev/null 2>&1; then
  desk_say "a previous session is still connected, closing it first."
  pkill -f "[s]dl-freerdp /v:127.0.0.1:${DESK_LOCAL_PORT}" 2>/dev/null
  _client_gone() {
    ! pgrep -f "[s]dl-freerdp /v:127.0.0.1:${DESK_LOCAL_PORT}" >/dev/null 2>&1
  }
  # Bounded: 10 tries, one second apart, so ten seconds worst case.
  desk_retry 10 1 1 -- _client_gone \
    || desk_warn "the previous client did not exit; this connect may be taken from you."
fi

desk_ensure_master

# ─── preflight: heal an orphaned session before it kills the connection ──────
# A session that outlived its sesman is untracked forever, and every later
# connect then makes a new one that dies at once. The why is in
# remote/heal-orphans.sh, beside the code that does it.
#
# Best effort: a server that cannot be healed is still worth trying to reach.
desk_remote_run heal-orphans.sh >/dev/null 2>&1 || true

desk_log "forward: ${DESK_LOCAL_PORT} -> ${DESK_RDP_ADDR}:${DESK_RDP_PORT}"
desk_forward

# ─── the connection flags ────────────────────────────────────────────────────
# Built by lib/freerdp-args.sh, which is pure and therefore testable. Every flag
# is there because the obvious alternative broke something; the reasoning lives
# beside each one in that file, and at length in docs/why-these-settings.md.
desk_build_args
ARGS=( "${DESK_ARGS[@]}" )

# macOS Spaces. A straight trade-off, not a bug to fix:
#   1 (default) fullscreen gets its own Space, so a three-finger swipe reaches
#               it and the green button works. Cost: FreeRDP builds a window,
#               tears it down, then builds the session window, so the Space is
#               created and destroyed once at startup and the screen flashes.
#   0           stays on the current desktop. No flash, but no Space either.
export SDL_VIDEO_MAC_FULLSCREEN_SPACES="${DESK_SPACES:-1}"

# Which renderer SDL draws with, and the single most important line in this file.
#
# The freeze was never the server, the clipboard or the network. macOS had
# already written down what it was, twice, and nothing here was reading it:
# /Library/Logs/DiagnosticReports/sdl-freerdp-*.hang, 37 seconds on one day and
# 146 on the next, every sample of the main thread in the same place.
#
#   SdlContext::drawToWindows -> drawToWindow -> SDL_RenderPresent
#     -> METAL_ActivateRenderCommandEncoder
#       -> -[CAMetalLayer nextDrawable]
#         -> _dispatch_semaphore_wait_slow          <- stuck here
#
# A CAMetalLayer hands out three drawables and blocks until one comes back. The
# client asks for one per flush and presents one per frame, so any frame that
# flushes more than once, which is any frame with several damaged rectangles,
# leaks the extras. Three of those and the pool is empty for good. Scrolling is
# what produces damaged rectangles by the dozen, which is why it always felt
# like the scroll, and it is also why the window dies rather than slows: the
# main thread stops, so the RDP keepalive stops with it and the link times out.
# Nothing about the far side is involved, which is why both machines did it.
#
# So do not draw through Metal. SDL's OpenGL renderer has no drawable pool and
# no such wait, and on this hardware it costs nothing measurable. Metal is still
# one word away for anyone who wants to check whether a newer SDL has fixed it.
export SDL_RENDER_DRIVER="${DESK_RENDERER:-opengl}"

# Do not block the main thread on the buffer swap. This is the top frame in the
# sample taken while the window was actually frozen, at normal priority, on the
# OpenGL renderer, so it is measured rather than reasoned:
#
#   2391 samples in drawToWindows
#     1332  SDL_RenderPresent -> Cocoa_GL_SwapWindow -> CGLFlushDrawable   <- 56%
#      885  drawScaledRects -> drawScaledRect -> SDL_UpdateTexture         <- 37%
#
# The client presents once per update from the server, and a swap that waits for
# the display costs a whole frame each time. Scrolling sends updates faster than
# the display refreshes, so the presents queue, the main thread parks in the
# swap, and macOS calls the window Not Responding. The pointer is a spinner
# because the thread that would move it is inside CGLFlushDrawable.
#
# Turning the wait off does not drop frames that were going to be seen: nothing
# is being animated here, the picture is whatever the far side last sent.
export SDL_RENDER_VSYNC="${DESK_VSYNC:-0}"

desk_say "log: $LOG"
desk_log "args: ${ARGS[*]}"
desk_log "renderer: $SDL_RENDER_DRIVER, vsync $SDL_RENDER_VSYNC"

# ─── helpers that live exactly as long as the client ─────────────────────────
HELPERS=()

cleanup() {
  local p
  for p in "${HELPERS[@]:-}"; do kill "$p" 2>/dev/null || true; done
  HELPERS=()
  # Belt and braces, in case a helper died without cleaning up after itself.
  # desk_remote_pkill brackets the pattern so it cannot match the ssh shell
  # that is running it, which used to kill the cleanup halfway through.
  desk_remote_pkill "deskclip-agent"
  desk_remote_pkill "xclip -selection clipboard"
}
# Releasing the lock is NOT part of cleanup, and the difference is not academic.
# The reconnect loop calls cleanup after every client, so putting the release in
# there meant the first blip handed the lock back while this desk was still very
# much alive and about to open another client. Found it live: one desk running,
# reconnected once, and no pid file left for the next desk to collide with.
#
# So the release goes on the trap, which fires once, on the way out.
_release_lock() {
  [ -n "${LOCK:-}" ] || return 0
  # Only if it is still ours. A desk that took the lock from us has already
  # written its own pid here, and removing that would let a third one in.
  [ "$(cat "$LOCK" 2>/dev/null)" = "$$" ] && rm -f "$LOCK"
  return 0
}
trap 'cleanup; _release_lock' EXIT INT TERM

# Wait for the session's X display to exist, then set up everything that needs
# to talk to it.
#
# The display is DISCOVERED, not assumed. It used to be the constant :150, and
# that is wrong whenever a session fails to start there and xrdp hands out :151
# next: the layout is then pushed at a display that is not there and the
# clipboard bridge owns a selection nobody reads. Both fail silently.
#
# It also has to WAIT, because on a first connect the session does not exist
# yet when this runs. Bounded at 15 tries, 2 seconds apart, so 30 seconds worst
# case and never forever.
#
# It runs in the background, which means it runs in a SUBSHELL, so anything it
# adds to HELPERS is added to its own copy and the parent never sees it. That
# is why it keeps and kills its own children here rather than reporting them
# upwards: without this, desk-clip outlived desk, kept the SSH channel open and
# went on owning the remote clipboard selection after the window had closed.
session_helper() {
  local display="" kids=()
  # shellcheck disable=SC2317,SC2329  # invoked by the trap below, not by name
  _reap() { local k; for k in "${kids[@]:-}"; do kill "$k" 2>/dev/null; done; }
  trap _reap EXIT TERM INT

  # Bounded at 15 tries, 2 seconds apart, so 30 seconds worst case.
  _found() { display="$(desk_remote_display 2>/dev/null)"; [ -n "$display" ]; }
  if ! desk_retry 15 2 1 -- _found; then
    desk_warn "session: could not find an X display at or above :$DESK_DISPLAY_MIN after 30s."
    desk_warn "         The keyboard layout and the clipboard bridge are both off."
    desk_warn "         Run desk-doctor to see why."
    return 1
  fi
  desk_say "session: display $display"

  apply_layout "$display" &
  kids+=($!)

  # The -x test used to be the whole condition, so a missing desk-clip meant a
  # session with no clipboard at all and not one word about why. Say it instead.
  if [ "${DESK_CLIP:-bridge}" != "rdp" ]; then
    if [ -x "$BIN/desk-clip" ]; then
      # The marker is for `ps`, not for desk-clip, which reads none of it. It is
      # what lets --restart end this machine's bridge and leave the other
      # machine's alone.
      DESK_DISPLAY="$display" "$BIN/desk-clip" --for "$DESK_HOST:$DESK_LOCAL_PORT" &
      kids+=($!)
    else
      desk_warn "clipboard: desk-clip is not at $BIN/desk-clip, so text will NOT cross."
    fi
  fi

  # Stay alive while the children do. The trap above fires when this is killed,
  # which is what actually stops them.
  wait
}

# Push the keyboard layout into the live X session.
#
# The work itself is remote/apply-layout.sh. Three consecutive passes are
# required before it is believed, because xrdp can overwrite the keymap after
# the first one lands, so a single success is not proof.
#
# Bounded by desk_retry: 12 tries, 2 seconds apart.
apply_layout() {
  local display="$1"
  if desk_retry 12 2 3 -- desk_remote_run apply-layout.sh \
       "DISP=$display" "LAYOUTS=$DESK_LAYOUTS" "TOGGLE=$DESK_LAYOUT_TOGGLE"; then
    case "$DESK_LAYOUTS" in
      *,*) desk_say "keyboard: $DESK_LAYOUTS ready (Option+Shift switches)" ;;
      *)   desk_say "keyboard: $DESK_LAYOUTS ready" ;;
    esac
    return 0
  fi
  desk_warn "keyboard: could not confirm '$DESK_LAYOUTS' after 12 tries."
  return 1
}

# Run the client. The password is read from the Keychain and handed to FreeRDP
# on stdin, so it never appears in `ps` or in a file.
run_client() {
  local rc
  if security find-generic-password -s "$DESK_KEYCHAIN_SERVICE" -a "$DESK_USER" -w >/dev/null 2>&1; then
    security find-generic-password -s "$DESK_KEYCHAIN_SERVICE" -a "$DESK_USER" -w \
      | sdl-freerdp "${ARGS[@]}" /from-stdin:force 2>&1 | tee -a "$LOG"
    # Index 1, not 0. The pipeline is security | sdl-freerdp | tee, so index 0
    # is the Keychain lookup, which all but always succeeds. Reading index 0
    # here meant desk always exited 0 and the failure excerpt below never
    # printed, which is exactly when you most want it.
    rc="${PIPESTATUS[1]}"
  else
    # Refuse, rather than warn and hand over FreeRDP's own credentials box.
    #
    # The warning was printed and then scrolled past, and what the person
    # actually saw was a dialog asking for a username, a domain and a password,
    # with no hint that nothing had been stored and no hint that the account on
    # the far side may not even have a password yet. Typing into it cannot work
    # in the case that produces it, so it is a dead end wearing the costume of a
    # login prompt. Failing here says both halves of the fix instead.
    #
    # DESK_ASK=1 still gets the old behaviour, for anyone who genuinely wants to
    # type it by hand and knows the account can accept it.
    if [ "${DESK_ASK:-0}" != 1 ]; then
      desk_warn "No password stored for '$DESK_USER' on $DESK_HOST, so there is nothing to log in with."
      desk_warn ""
      desk_warn "Two steps, and they are separate machines:"
      desk_warn "  1. on the server, give the account a password:  ssh $DESK_HOST 'sudo passwd $DESK_USER'"
      desk_warn "     (an account made with --disabled-password has none, and xrdp refuses it)"
      desk_warn "  2. on this Mac, store that same password:       desk-setup"
      desk_warn ""
      desk_warn "Then: desk-doctor && desk.  To type it by hand instead: DESK_ASK=1 desk"
      return 1
    fi
    desk_warn "No Keychain item for '$DESK_KEYCHAIN_SERVICE'; FreeRDP will ask. Run desk-setup to stop that."
    sdl-freerdp "${ARGS[@]}" 2>&1 | tee -a "$LOG"
    rc="${PIPESTATUS[0]}"
  fi
  return "$rc"
}

# ─── survive a blip instead of dying with it ─────────────────────────────────
# The SSH master drops every hour or two: a wifi handoff, the proxy rotating a
# node, the laptop dozing. FreeRDP loses its TCP, prints "Network disconnect!",
# and `desk` used to exit with it. The session on the server was untouched the
# whole time, so the desktop was still there and simply nobody was showing it.
# You came back to a dead window for a fault that had already healed itself.
#
# So reconnect. The hard part is telling a drop apart from you closing the
# window, and the honest signal is not the exit code, which is 131 either way.
# It is the state left behind: after a drop the tunnel is gone, after a close
# everything is still healthy. So we ask, rather than guess.
#
# Bounded, because a laptop that reconnects forever in the background is worse
# than one that stops: 6 attempts, 20 seconds apart, so about two minutes.
RECONNECT_TRIES="${DESK_RECONNECT_TRIES:-6}"
attempt=0

while :; do
  session_helper &
  HELPERS+=($!)

  run_client
  rc=$?
  cleanup
  echo "exit=$rc" >> "$LOG"

  [ "$rc" -eq 0 ] && break

  # Healthy tunnel means the connection was not what ended: you closed the
  # window. Leave, and leave quietly.
  if nc -z -G 3 127.0.0.1 "$DESK_LOCAL_PORT" 2>/dev/null; then
    break
  fi

  attempt=$((attempt + 1))
  if [ "$attempt" -gt "$RECONNECT_TRIES" ]; then
    desk_warn "the connection dropped and did not come back after $RECONNECT_TRIES tries."
    break
  fi

  desk_say "connection dropped, reconnecting ($attempt/$RECONNECT_TRIES)..."
  sleep 20

  # Rebuild both halves. Either can be the one that died, and desk_ensure_master
  # is already a no-op when the master is fine.
  #
  # In a SUBSHELL, because both of these call desk_die on failure. Dying is the
  # right answer at startup and the wrong one here: a login that fails on try
  # two is exactly what try three is for. The subshell contains the exit, and
  # the tunnel check below decides whether it actually worked.
  ( desk_ensure_master && desk_forward ) >/dev/null 2>&1
  if ! nc -z -G 3 127.0.0.1 "$DESK_LOCAL_PORT" 2>/dev/null; then
    desk_say "  tunnel still down, will try again."
    continue
  fi
done

if [ "$rc" -ne 0 ]; then
  echo
  echo "--- last failure, from the log ---"
  grep -iE 'FATAL|ERROR' "$LOG" \
    | grep -viE 'tcsetattr|tcgetattr|backtrace|log_build_warn' \
    | tail -6 | cut -c1-190
  echo
  echo "desk-doctor checks every precondition and usually names the cause."
fi
exit "$rc"

}

main "$@"
