#!/usr/bin/env python3
"""Clipboard bridge between this Mac and the remote Linux desktop.

Started and stopped by `desk-tunnel`. It reads its settings from the environment,
which `desk-tunnel` exports: DESK_HOST, DESK_SSH_SOCKET, DESK_DISPLAY.

Why this exists instead of the RDP clipboard channel
----------------------------------------------------
The RDP clipboard carries ASCII and silently drops everything else. Measured
against a live session, with the pasteboard read through NSPasteboard so no
shell locale sits anywhere in the path:

  "ASCII-VIA-CLIPRDR-777"  ->  21 bytes on the remote clipboard, exact
  Persian, 54 bytes        ->  0 bytes. The X selection changes owner and then
                               serves nothing at all.
  "ASCII-AGAIN-888"        ->  15 bytes, exact. So the channel is not wedged,
                               it just cannot carry this item.

FreeRDP says so itself in the log, at exactly those moments:

  [ERROR][com.winpr.clipboard] - [ClipboardGetData]: No synthesizer for format
  CF_RAW [0x00000000] --> text/plain [0x0000c000]

`/clipboard:` has only use-selection, direction-to and files-to, so there is no
encoding or format option to fix it with. Text therefore rides the SSH master
that is already up for the tunnel: base64 in, base64 out, no codepage anywhere.

It carries text both ways and pictures both ways, as png. Files still go through
the shared drive.

The RDP clipboard channel has to be OFF while this runs, for two reasons. Two
owners of the X CLIPBOARD selection race, and xrdp-chansrv wins often enough to
hand back the broken copy. And Windows App deadlocks outright when an image
reaches the Mac pasteboard while it is redirecting the clipboard, which is the
bug that brought this file back after it had been deleted.

A trap worth naming, because it cost hours
------------------------------------------
`pbcopy` and `pbpaste` pick their encoding from the caller's locale, and Python
exports LC_CTYPE=C.UTF-8 to its children. That is a glibc name macOS does not
know, so both tools fall back to MacRoman and quietly mangle non-ASCII text.
Worse, a pbcopy/pbpaste round trip still MATCHES, because both ends mangle the
same way. That is a test passing for the wrong reason, and it produced a
completely wrong diagnosis before NSPasteboard was used as the referee. Hence
PB_ENV below: the locale is pinned for every pasteboard call, never inherited.
"""

import base64
import os
import signal
import subprocess
import sys
import threading
import time

# Built by mac/install.sh from mac/pbio.swift, and kept beside this file. It is
# how an image is seen at all: pbpaste speaks text only, so before this a picture
# on the pasteboard was invisible to the bridge and could not cross.
PBIO = os.path.join(os.path.dirname(os.path.realpath(__file__)), "desk-pbio")

# argv carries one thing and one thing only: "--for <host>:<port>", passed by
# desk-tunnel so two bridges can be told apart in `ps`. The port is read back
# out of it below to answer "is anyone actually connected to my machine", which
# is what stops two bridges fighting over the Mac pasteboard. Every actual
# SETTING still arrives in the environment, which is what main() checks for. Without the marker, the only way
# to end one machine's bridge was `pkill -f desk-clip`, which ended the other
# machine's as well and left it running with a clipboard that had silently
# stopped crossing.
HOST = os.environ.get("DESK_HOST", "")
SOCKET = os.environ.get("DESK_SSH_SOCKET", "")
DISPLAY = os.environ.get("DESK_DISPLAY", "")
# The port this machine's tunnel listens on, taken from the "--for host:port"
# marker desk-tunnel passes for `ps` to tell two bridges apart. It is the only
# thing here that knows which machine this bridge belongs to.
LOCAL_PORT = ""
for _i, _a in enumerate(sys.argv):
    if _a == "--for" and _i + 1 < len(sys.argv) and ":" in sys.argv[_i + 1]:
        LOCAL_PORT = sys.argv[_i + 1].rsplit(":", 1)[1]

MAC_POLL = 0.10          # local and free, so poll it fast
START_TIMEOUT = 20.0     # ceiling on bringing the agent up
RETRY_WAIT = 3.0         # first reconnect attempt, doubled after each failure
RETRY_WAIT_MAX = 60.0    # ceiling on that doubling
MAX_CONSECUTIVE_FAILURES = 10   # about nine minutes of failing before giving up

# The agent script lives under the remote user's own cache directory, never in
# /tmp. On a shared box /tmp is writable by every tenant, so a fixed name there
# is a path another user can own first: our write then fails, or worse, theirs
# is the file that runs. $HOME is ours alone.
AGENT_DIR = ".cache/remote-claude-desk"
AGENT = AGENT_DIR + "/deskclip-agent.py"

# pbcopy/pbpaste read their encoding from the environment, and an inherited
# LC_CTYPE=C.UTF-8 makes them fall back to MacRoman. Pin it, do not inherit it.
PB_ENV = {k: v for k, v in os.environ.items()
          if k not in ("LC_ALL", "LC_CTYPE", "LANG")}
PB_ENV["LC_ALL"] = "en_US.UTF-8"

# Nothing sane is copied at this size, and a runaway feedback loop between the
# two clipboards IS the thing that grows past it. An early version of this
# bridge bounced 35 -> 69 -> 137 -> 1998 bytes and kept going, which froze a
# paste inside the session. The loop is fixed now, but a hard ceiling costs one
# comparison and turns any future version of that bug into a skipped item
# instead of a hang.
MAX_BYTES = 2 * 1024 * 1024
# Files get their own ceiling, and a much larger one. The 2 MB above is about
# what belongs in a CLIPBOARD selection; a file someone copied deliberately is a
# different thing, and 64 MB covers a document or a short video without letting
# a stray Downloads folder selection saturate the SSH master the desktop's own
# pixels travel on.
MAX_FILE_BYTES = 64 * 1024 * 1024


def log(msg):
    sys.stderr.write("desk-clip: %s\n" % msg)
    sys.stderr.flush()


# The agent source. A real file in remote/, not a string literal, so python
# actually parses it and an editor actually highlights it. It used to be a
# 59-line r-string here, where a syntax error would only surface on the server
# at runtime.
AGENT_SRC = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
    "remote", "clip-agent.py")


def ssh(args, **kw):
    return subprocess.run(
        ["ssh", "-o", "ConnectTimeout=10", "-S", SOCKET, HOST] + args, **kw)


def install_agent():
    """Copy the agent into the remote user's own cache dir. One round trip."""
    try:
        with open(AGENT_SRC, "rb") as fh:
            source = fh.read()
    except OSError as e:
        log("cannot read %s: %s" % (AGENT_SRC, e))
        return False
    r = ssh(["mkdir -p ~/%s && chmod 700 ~/%s && cat > ~/%s"
             % (AGENT_DIR, AGENT_DIR, AGENT)],
            input=source, timeout=30)
    return r.returncode == 0


def start_agent():
    """Bring one agent up and wait for READY. Returns the process or None."""
    ag = subprocess.Popen(
        ["ssh", "-o", "ConnectTimeout=10", "-S", SOCKET, HOST,
         "python3 -u ~/%s %s" % (AGENT, DISPLAY)],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)

    deadline = time.time() + START_TIMEOUT
    while time.time() < deadline:
        line = ag.stdout.readline()
        if line.strip() == b"READY":
            return ag
        if not line:
            log("agent died on startup")
            return None
    ag.kill()
    log("agent did not report READY within %.0fs, killed it" % START_TIMEOUT)
    return None


def send_files(paths):
    """Copy files to the server over the SSH master, return their remote paths.

    One tar over one ssh, rather than a copy per file. tar takes -C more than
    once, so a selection spanning several folders still travels in a single
    round trip, and it carries the names as bytes: a filename with a space, a
    quote or Persian in it needs no quoting anywhere in this function, which is
    the part that would otherwise break first.
    """
    total = 0
    for p in paths:
        try:
            total += os.path.getsize(p)
        except OSError:
            return None, "cannot read %s" % os.path.basename(p)
    if total > MAX_FILE_BYTES:
        return None, "%d MB is over the %d MB limit" % (
            total // (1 << 20), MAX_FILE_BYTES // (1 << 20))

    stamp = "%d" % int(time.time() * 1000)
    remote_dir = "%s/clip/%s" % (AGENT_DIR, stamp)

    args = []
    for p in paths:
        args += ["-C", os.path.dirname(p) or "/", os.path.basename(p)]

    # COPYFILE_DISABLE, because macOS tar otherwise packs an AppleDouble
    # "._name" beside every file to carry resource forks and Finder metadata.
    # Nothing on Linux wants them, and they arrive as visible junk next to the
    # file the person actually copied.
    tar = subprocess.Popen(["tar", "-cf", "-"] + args,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           env=dict(os.environ, COPYFILE_DISABLE="1"))
    # Prune while we are here, in the same round trip. Every copy leaves a
    # directory behind, and nothing else would ever remove them: the twentieth
    # oldest and beyond go, which keeps a session's recent pastes usable and
    # stops a year of copying from filling the home directory.
    r = ssh(["mkdir -p ~/%s && tar -C ~/%s -xf - && "
             "ls -1dt ~/%s/clip/*/ 2>/dev/null | tail -n +21 | xargs -r rm -rf"
             % (remote_dir, remote_dir, AGENT_DIR)],
            stdin=tar.stdout, timeout=120)
    tar.stdout.close()
    tar.wait()
    if r.returncode != 0:
        return None, "the copy failed (ssh rc=%s)" % r.returncode

    return ["~/%s/%s" % (remote_dir, os.path.basename(p)) for p in paths], None


def pump(ag):
    """Carry the clipboard both ways until the agent goes away.

    One "last value seen" per direction, which is all a bridge needs. An earlier
    version kept a HISTORY of everything it had carried and skipped anything
    already in it. That stopped the ping-pong but broke two real cases: copying
    the same text twice did nothing the second time, and re-copying on the Mac
    something you had pasted out of the session silently did nothing.

    Change detection per side has neither problem. A value arriving FROM the
    remote is recorded as the Mac's current value at the same moment it is
    written there, so the Mac poll sees no change and cannot send it back.
    """
    last = {"mac": None, "remote": None}
    warned = {"big": None}
    lock = threading.Lock()

    def connected():
        """Is a client actually attached to THIS machine's tunnel right now.

        Two machines means two bridges, and both of them write the same Mac
        pasteboard. Left ungated they fight: a copy inside machine A lands on
        the Mac, machine B's bridge sees the Mac change and pushes it into B,
        B's agent reports it back, and the pasteboard ends up holding whichever
        of them wrote last. Measured as exactly that, with one machine showing a
        stale selection and the Mac briefly holding nothing at all.

        The Mac to remote direction is safe from both: sending the same thing to
        two machines is what you want. It is only the way back that needs an
        owner, and the honest owner is the machine you are actually looking at.
        An established connection on the forwarded port is that, and nothing
        else has to be configured or guessed.
        """
        try:
            r = subprocess.run(["lsof", "-nP", "-iTCP:%s" % LOCAL_PORT, "-sTCP:ESTABLISHED"],
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5)
            return b"ESTABLISHED" in r.stdout
        except Exception:
            return True    # cannot tell: behave as before rather than go silent

    def from_remote():
        for line in ag.stdout:
            if line.startswith(b"CLIPIMG "):
                kind, payload = "image", line[8:]
            elif line.startswith(b"CLIP "):
                kind, payload = "text", line[5:]
            else:
                continue
            try:
                data = base64.b64decode(payload.strip())
            except Exception:
                continue
            if len(data) > MAX_BYTES:
                log("remote clipboard is %d bytes, over the limit; ignoring"
                    % len(data))
                continue
            if not connected():
                # Not the machine in front of you. Record it so this value is
                # not treated as news later, but do not touch the pasteboard.
                with lock:
                    last["remote"] = data
                continue
            with lock:
                if data == last["remote"]:
                    continue
                last["remote"] = data
                last["mac"] = data     # BEFORE the write, so the Mac poll
                                       # cannot race in and bounce it back
            # Through pbio when it is there, because pbcopy speaks text only
            # and takes its encoding from the environment. pbcopy is the
            # fallback and can only carry text, so an image without pbio is
            # dropped rather than written as garbage.
            if os.path.exists(PBIO):
                subprocess.run([PBIO, "write", kind], input=data)
            elif kind == "text":
                subprocess.run(["pbcopy"], input=data, env=PB_ENV)
            else:
                log("an image came back but desk-pbio is not built, so it was dropped")

    threading.Thread(target=from_remote, daemon=True).start()

    # Mac to remote. pbpaste is local and free, so poll it fast: a dictation
    # tool may set the pasteboard and synthesise Cmd+V 600 ms later, and the
    # push has to land inside that window. Measured: about 100 ms to notice
    # plus about 150 ms one way.
    # The last pasteboard generation we fetched. A dict rather than a name so the
    # loop below can set it without a global.
    seen = {"count": ""}

    while True:
        if ag.poll() is not None:
            log("agent exited (rc=%s)" % ag.returncode)
            return
        try:
            kind = "text"
            if os.path.exists(PBIO):
                said = subprocess.run([PBIO, "kind"], stdout=subprocess.PIPE,
                                      timeout=5).stdout.decode().split()
                kind = said[1] if len(said) > 1 else "none"
                if kind == "none":
                    time.sleep(MAC_POLL)
                    continue
                # Ask for the contents only when the pasteboard has actually
                # changed. changeCount is the one number NSPasteboard guarantees
                # for this, and ignoring it was expensive in a way text hid: an
                # image sat on the pasteboard and this re-read the whole picture
                # ten times a second, for as long as it was there. On the machine
                # it was found, 221 KB a tick, over the same SSH master the
                # desktop's own pixels travel on.
                count = said[0]
                if count == seen["count"]:
                    time.sleep(MAC_POLL)
                    continue
                seen["count"] = count
                data = subprocess.run([PBIO, "read", kind], stdout=subprocess.PIPE,
                                      timeout=10).stdout

                # Files are the one kind where what is on the pasteboard is not
                # what has to cross. The pasteboard holds paths on THIS machine,
                # which mean nothing on the far side, so the bytes go over the
                # master and what the session's clipboard ends up holding is the
                # paths they landed at.
                if kind == "files":
                    paths = [p for p in data.decode("utf-8", "replace").split("\n") if p]
                    if not paths:
                        time.sleep(MAC_POLL); continue
                    with lock:
                        new_sel = data != last["mac"]
                        if new_sel:
                            last["mac"] = data
                            last["remote"] = data
                    if new_sel:
                        remote, why = send_files(paths)
                        if remote is None:
                            log("not copying %d file(s): %s" % (len(paths), why))
                        else:
                            log("copied %d file(s) to the session" % len(remote))
                            try:
                                ag.stdin.write(b"SETFILES " + base64.b64encode(
                                    "\n".join(remote).encode()) + b"\n")
                                ag.stdin.flush()
                            except Exception:
                                log("lost the agent channel")
                                return
                    time.sleep(MAC_POLL)
                    continue
            else:
                data = subprocess.run(["pbpaste"], stdout=subprocess.PIPE,
                                      timeout=5, env=PB_ENV).stdout
        except Exception:
            time.sleep(MAC_POLL)
            continue
        if data and len(data) > MAX_BYTES:
            if warned["big"] != len(data):
                warned["big"] = len(data)
                log("clipboard is %d bytes, over the %d limit; not syncing it"
                    % (len(data), MAX_BYTES))
            time.sleep(MAC_POLL)
            continue
        if data:
            with lock:
                new = data != last["mac"]
                if new:
                    last["mac"] = data
                    last["remote"] = data
            if new:
                try:
                    verb = b"SETIMG " if kind == "image" else b"SET "
                    ag.stdin.write(verb + base64.b64encode(data) + b"\n")
                    ag.stdin.flush()
                except Exception:
                    log("lost the agent channel")
                    return
        time.sleep(MAC_POLL)


def main():
    # The contract with `desk`, stated rather than assumed. desk-clip is Python
    # and cannot read config.sh, so these three arrive as environment variables
    # that `desk` exports. Nothing else declares that, and until this check
    # existed a dropped export produced a bridge that started and carried
    # nothing.
    for name, value in (("DESK_HOST", HOST), ("DESK_SSH_SOCKET", SOCKET),
                        ("DESK_DISPLAY", DISPLAY)):
        if not value:
            log("%s is not set. desk-clip is started by desk-tunnel, not by hand."
                % name)
            return 2

    current = {"agent": None}

    # Clean up after ourselves on the way out. Without this, a terminated
    # bridge left the remote agent holding the X CLIPBOARD selection, and the
    # next session inherited a clipboard nothing was feeding.
    def bye(_signum=None, _frame=None):
        ag = current["agent"]
        if ag and ag.poll() is None:
            try:
                ag.stdin.write(b"BYE\n")
                ag.stdin.flush()
            except Exception:
                pass
            try:
                ag.wait(timeout=3)
            except Exception:
                ag.kill()
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    # Reconnect rather than exit. The SSH master can drop while the session
    # itself is perfectly fine, and the old behaviour was to return here and
    # leave `desk` running with a clipboard that had silently stopped working.
    # Bounded: consecutive failures are counted, so a genuinely broken setup
    # says so instead of retrying forever.
    # The wait grows, and that is the difference between surviving an outage and
    # dying in one. Ten tries three seconds apart is thirty seconds: a wifi
    # handoff outlives it, and the bridge would give up while the laptop was
    # still finding a network. Doubling to a minute spends the same ten tries
    # over nine minutes instead, so a real outage is ridden out and a genuinely
    # broken setup still says so rather than retrying forever.
    def backoff(n):
        return min(RETRY_WAIT * (2 ** n), RETRY_WAIT_MAX)

    failures = 0
    first = True
    while failures < MAX_CONSECUTIVE_FAILURES:
        # Installing the agent is INSIDE the loop, and that is the whole point.
        # It used to run once above it, and a single failed round trip ended the
        # bridge for good: "could not install the remote agent, giving up",
        # return 1, with the ten-try backoff below left untouched a few lines
        # away. A thirty-second network drop was enough. The clipboard then
        # stayed dead until something else happened to restart it, which on the
        # night this was found was a person noticing by hand.
        #
        # The retry that already existed for RUNNING the agent is the same
        # retry that INSTALLING it needs, for the same reason, against the same
        # outage. One loop, both steps.
        if not install_agent():
            failures += 1
            log("could not install the remote agent (attempt %d of %d)"
                % (failures, MAX_CONSECUTIVE_FAILURES))
            time.sleep(backoff(failures - 1))
            continue

        ag = start_agent()
        if ag is None:
            failures += 1
            time.sleep(backoff(failures - 1))
            continue
        current["agent"] = ag
        if first:
            log("bridge up on %s (text and images, both ways)" % DISPLAY)
            first = False
        else:
            log("bridge back up on %s" % DISPLAY)

        started = time.time()
        pump(ag)
        current["agent"] = None

        # A session that reported READY and then died at once is a failure, not
        # a success. Resetting the counter on READY alone would spin forever
        # against a display that has gone away, which is exactly the case this
        # loop exists to survive.
        if time.time() - started < 5.0:
            failures += 1
        else:
            failures = 0

        wait = backoff(failures)
        log("reconnecting in %.0fs..." % wait)
        time.sleep(wait)

    # Exiting is not the end of the clipboard: desk-tunnel --watch notices the
    # bridge is gone and a fresh run starts a new one. Saying so matters,
    # because the old line read like a dead end and sent people to restart
    # things by hand.
    log("gave up after %d consecutive failures; desk-tunnel --watch will start a new one."
        % MAX_CONSECUTIVE_FAILURES)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
