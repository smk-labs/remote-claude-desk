#!/usr/bin/env bash
# @APP_NAME@, isolated from the central agent config and from every other user
# on this machine. install.sh stamps this template per app; edit the template
# in the repo, never the installed copy.
set -euo pipefail
ROOT=@APP_ROOT@
APP_BIN=@APP_BIN@

# The installer stamps in the account this copy belongs to. ROOT is chmod 700,
# so another user gets a confusing permissions error several lines later
# instead of this one clear line.
[ "$(id -un)" = "@DESK_USER@" ] || { echo "Refusing: this launcher belongs to @DESK_USER@, you are $(id -un)." >&2; exit 1; }

# --- guard: never attach to another user's X display -------------------------
d="${DISPLAY:-}"
[ -n "$d" ] || { echo "No DISPLAY. Run this inside the RDP session." >&2; exit 1; }
n="${d#:}"; n="${n%%.*}"
case "$n" in ''|*[!0-9]*) echo "Refusing: DISPLAY='$d' is not a plain display." >&2; exit 1 ;; esac
[ "$n" -ge @DESK_DISPLAY_MIN@ ] || { echo "Refusing: :$n belongs to another user on this shared box." >&2; exit 1; }
owner=$(stat -c %U "/tmp/.X11-unix/X$n" 2>/dev/null || echo "?")
[ "$owner" = "$(id -un)" ] || { echo "Refusing: display :$n is owned by '$owner'." >&2; exit 1; }

# --- isolated state ----------------------------------------------------------
# Both agent homes are redirected for every app, not just the one that owns
# them: Claude Desktop ships Claude Code and the ChatGPT app ships Codex, so
# either can start an agent that would otherwise read plugins, skills and MCP
# servers from the central ~/.claude or ~/.codex.
export CLAUDE_CONFIG_DIR="$ROOT/agent/claude"
export CODEX_HOME="$ROOT/agent/codex"
export XDG_CONFIG_HOME="$ROOT/xdg/config"
export XDG_CACHE_HOME="$ROOT/xdg/cache"
mkdir -p "$ROOT"/agent/{claude,codex} "$ROOT"/xdg/{config,cache} "$ROOT"/{profile,work,logs}
chmod 700 "$ROOT" 2>/dev/null || true

# XDG_DATA_HOME is deliberately NOT redirected. The secret store is the session
# keyring, which pam_gnome_keyring unlocks with the RDP login password. Pointing
# the app at a different data dir does not move that keyring (it lives with the
# daemon that owns org.freedesktop.secrets), it only breaks the lookup.

# Per-host settings, mode 600, never in git. PROXY_URL is the one that matters:
# a box whose egress is blocked needs it, a box with clean egress must not have
# it. Kept out of the launcher so the proxy can change without a reinstall.
if [ -r "$ROOT/env" ]; then . "$ROOT/env"; fi

flags=(
  --user-data-dir="$ROOT/profile"
  --disable-gpu --disable-gpu-compositing
  --password-store=gnome-libsecret
)

if [ -n "${PROXY_URL:-}" ]; then
  # --proxy-server only covers Chromium's own network stack. These apps also
  # ship native agent binaries with their own HTTP clients, which would egress
  # direct and leak straight past the flag, so the env vars are not belt and
  # braces here, they cover a real second path out.
  flags+=( --proxy-server="$PROXY_URL" )
  export HTTPS_PROXY="$PROXY_URL" HTTP_PROXY="$PROXY_URL" ALL_PROXY="$PROXY_URL"
  export https_proxy="$PROXY_URL" http_proxy="$PROXY_URL" all_proxy="$PROXY_URL"
fi

cd "$ROOT/work"
exec "$APP_BIN" "${flags[@]}" "$@" >>"$ROOT/logs/desktop.log" 2>&1
